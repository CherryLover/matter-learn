---
import { ArrowUpRight } from 'lucide-astro';
import { type Lang } from '../i18n/config';
import { t } from '../i18n/ui';
import { getSiteNav } from '../i18n/site-nav';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const nav = getSiteNav(lang);

---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-grid">
      <!-- Column 1: About -->
      <div class="footer-col">
        <div class="footer-brand">
          <svg class="footer-logo-icon" width="20" height="20" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
            <polygon points="60,6 103,31 103,81 60,106 17,81 17,31" stroke="currentColor" stroke-width="6"/>
            <text x="60" y="74" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="46" font-weight="700" fill="currentColor" letter-spacing="-2">M</text>
            <circle cx="60" cy="6" r="6" fill="currentColor" opacity="0.7"/>
            <circle cx="103" cy="31" r="6" fill="currentColor" opacity="0.7"/>
            <circle cx="103" cy="81" r="6" fill="currentColor" opacity="0.7"/>
            <circle cx="60" cy="106" r="6" fill="currentColor" opacity="0.7"/>
            <circle cx="17" cy="81" r="6" fill="currentColor" opacity="0.7"/>
            <circle cx="17" cy="31" r="6" fill="currentColor" opacity="0.7"/>
          </svg>
          <span class="footer-brand-text">Matter Learn</span>
        </div>
        <p class="footer-about">
          {t(lang, 'footer.about')}
        </p>
        <p class="footer-note">
          <span class="footer-note-label">{t(lang, 'footer.dataSourceLabel')}</span>
          {t(lang, 'footer.dataSourceText')}
        </p>
      </div>

      <!-- Columns 2–5：与顶部导航同一份数据（getSiteNav） -->
      {nav.map((group) => (
        <div class="footer-col">
          <h3 class="footer-heading">{group.title}</h3>
          <ul class="footer-links">
            {group.links.map((link) => (
              <li>
                {link.external ? (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.title}
                    <ArrowUpRight class="ext-icon" size={11} strokeWidth={1.5} />
                  </a>
                ) : (
                  <a href={link.href}>{link.title}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom">
      <p set:html={t(lang, 'footer.copyright')} />
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #1e293b;
    color: #cbd5e1;
    margin-top: auto;
  }

  :global(.dark) .footer {
    background: #0f172a;
    border-top: 1px solid #1e293b;
  }

  .footer-inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 0;
  }

  /* 各栏按内容宽度排列，栏间空白平均分配，避免短栏右侧留出大片空白 */
  .footer-grid {
    display: grid;
    grid-template-columns: minmax(14rem, 18rem) repeat(4, max-content);
    justify-content: space-between;
    column-gap: 2.5rem;
    row-gap: 2rem;
    padding-bottom: 2.5rem;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .footer-logo-icon {
    color: #818cf8;
  }

  .footer-brand-text {
    font-size: 1rem;
    font-weight: 700;
    color: #e2e8f0;
    letter-spacing: -0.025em;
  }

  .footer-about {
    font-size: 0.8125rem;
    line-height: 1.7;
    color: #94a3b8;
  }

  .footer-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #e2e8f0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.875rem;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: #e2e8f0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ext-icon {
    flex-shrink: 0;
    opacity: 0.5;
  }

  .footer-links a:hover .ext-icon {
    opacity: 0.8;
  }

  .footer-about + .footer-note {
    margin-top: 1rem;
  }

  .footer-note {
    font-size: 0.8125rem;
    color: #94a3b8;
    line-height: 1.7;
  }

  .footer-note-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 500;
    color: #64748b;
    margin-bottom: 0.25rem;
  }

  .footer-bottom {
    border-top: 1px solid #334155;
    padding: 1.25rem 0;
    text-align: center;
  }

  :global(.dark) .footer-bottom {
    border-top-color: #1e293b;
  }

  .footer-bottom p {
    font-size: 0.75rem;
    color: #64748b;
    margin: 0;
  }

  /* 中等宽度：介绍独占一行，四个链接栏排在下面一行 */
  @media (max-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(4, max-content);
    }

    .footer-col:first-child {
      grid-column: 1 / -1;
      max-width: 36rem;
    }
  }

  /* 平板：链接栏改为两列 */
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-content: stretch;
      column-gap: 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      padding: 2rem 1rem 0;
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
      row-gap: 1.5rem;
      padding-bottom: 1.5rem;
    }
  }
</style>
