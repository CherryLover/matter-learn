---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

interface NavItem {
  title: string;
  href?: string;
  children?: NavItem[];
}

const navigation: NavItem[] = [
  { title: '首页', href: '/' },
  {
    title: '概念总览',
    children: [
      { title: 'Matter 协议基础', href: '/concepts/' },
      { title: 'Endpoint / Cluster / Attribute / Command', href: '/concepts/' },
    ],
  },
  {
    title: 'Cluster 手册',
    children: [
      { title: 'DoorLock (0x101)', href: '/clusters/door-lock/' },
      { title: 'PowerSource (0x2F)', href: '/clusters/power-source/' },
    ],
  },
  {
    title: '数据工具',
    children: [
      { title: 'JSON 解析器', href: '/tools/json-parser/' },
    ],
  },
];

function isActive(href: string | undefined, current: string): boolean {
  if (!href) return false;
  if (href === '/') return current === '/';
  return current.startsWith(href);
}

function isSectionActive(item: NavItem, current: string): boolean {
  if (item.href && isActive(item.href, current)) return true;
  if (item.children) {
    return item.children.some(child => isActive(child.href, current));
  }
  return false;
}
---

<div id="sidebar-overlay" class="sidebar-overlay"></div>
<aside id="sidebar" class="sidebar">
  <nav class="sidebar-nav">
    {navigation.map((item) => (
      <div class="nav-section">
        {item.href ? (
          <a
            href={item.href}
            class:list={['nav-link', 'nav-top', { active: isActive(item.href, currentPath) }]}
          >
            {item.title}
          </a>
        ) : (
          <button
            class:list={['nav-group-toggle', { expanded: isSectionActive(item, currentPath) }]}
            data-expanded={isSectionActive(item, currentPath) ? 'true' : 'false'}
          >
            <svg class="nav-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 2l4 4-4 4" />
            </svg>
            <span>{item.title}</span>
          </button>
        )}
        {item.children && (
          <div
            class:list={['nav-children', { expanded: isSectionActive(item, currentPath) }]}
          >
            {item.children.map((child) => (
              <a
                href={child.href}
                class:list={['nav-link', { active: isActive(child.href, currentPath) }]}
              >
                {child.title}
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </nav>
</aside>

<script is:inline>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.nav-group-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
      const isExpanded = this.getAttribute('data-expanded') === 'true';
      this.setAttribute('data-expanded', isExpanded ? 'false' : 'true');
      this.classList.toggle('expanded');
      const children = this.nextElementSibling;
      if (children) children.classList.toggle('expanded');
    });
  });
});
</script>

<style>
  .sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 29;
    background: rgba(0, 0, 0, 0.4);
  }

  .sidebar-overlay.open {
    display: block;
  }

  .sidebar {
    position: fixed;
    top: 56px;
    left: 0;
    bottom: 0;
    width: 260px;
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border-color);
    overflow-y: auto;
    z-index: 30;
    transition: transform 0.2s ease;
  }

  @media (max-width: 768px) {
    .sidebar {
      transform: translateX(-100%);
    }
    .sidebar.open {
      transform: translateX(0);
    }
  }

  .sidebar-nav {
    padding: 1rem 0;
  }

  .nav-section {
    margin-bottom: 0.25rem;
  }

  .nav-link {
    display: block;
    padding: 0.375rem 1rem 0.375rem 1.5rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: all 0.15s ease;
  }

  .nav-link.nav-top {
    padding-left: 1rem;
    font-weight: 500;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .nav-link.active {
    color: var(--color-primary-600, #4f46e5);
    border-left-color: var(--border-active);
    background: var(--color-primary-50, #eef2ff);
    font-weight: 500;
  }

  :global(.dark) .nav-link.active {
    color: var(--color-primary-400, #818cf8);
    background: rgba(99, 102, 241, 0.1);
  }

  .nav-group-toggle {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    width: 100%;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .nav-group-toggle:hover {
    color: var(--text-secondary);
  }

  .nav-arrow {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  .nav-group-toggle.expanded .nav-arrow {
    transform: rotate(90deg);
  }

  .nav-children {
    display: none;
  }

  .nav-children.expanded {
    display: block;
  }
</style>
