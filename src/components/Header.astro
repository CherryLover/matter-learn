---
import { ChevronDown, ArrowUpRight, Sun, Moon, Menu, X, Globe } from 'lucide-astro';
import { type Lang, localePath, getAlternateLang, stripLangPrefix } from '../i18n/config';
import { t } from '../i18n/ui';
import { getSiteNav } from '../i18n/site-nav';

interface Props {
  currentPath?: string;
  lang?: Lang;
}

const { currentPath = '', lang = 'zh' } = Astro.props;
const altLang = getAlternateLang(lang);
// 404 页没有对应的语言版本（/en/404/ 不存在），切换语言时回到对方语言首页
const altPath = stripLangPrefix(currentPath) === '/404/'
  ? localePath(altLang, '/')
  : localePath(altLang, currentPath);

interface NavItem {
  title: string;
  href?: string;
  external?: boolean;
  children?: NavItem[];
  dividerBefore?: boolean;
  megaMenu?: boolean;
  group?: boolean;
}

const lp = (path: string) => localePath(lang, path);

// 顶部导航与底部栏共用 getSiteNav：4 个大类，每类 4–5 个入口
const navigation: NavItem[] = getSiteNav(lang).map((group) => ({
  title: group.title,
  children: group.links,
}));

// Strip lang prefix for matching active state
const pathForActive = stripLangPrefix(currentPath);

function isActive(href: string | undefined, current: string): boolean {
  if (!href) return false;
  const clean = stripLangPrefix(href);
  if (clean === '/') return current === '/';
  return current.startsWith(clean);
}

function isDropdownActive(item: NavItem, current: string): boolean {
  if (item.children) {
    return item.children.some(child => !child.external && isActive(child.href, current));
  }
  return false;
}
---

<header class="header">
  <div class="header-inner">
    <!-- Logo -->
    <a href={lp('/')} class="logo">
      <svg class="logo-icon" width="24" height="24" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
        <polygon points="60,6 103,31 103,81 60,106 17,81 17,31" stroke="currentColor" stroke-width="6"/>
        <text x="60" y="74" text-anchor="middle" font-family="system-ui,-apple-system,sans-serif" font-size="46" font-weight="700" fill="currentColor" letter-spacing="-2">M</text>
        <circle cx="60" cy="6" r="6" fill="currentColor" opacity="0.7"/>
        <circle cx="103" cy="31" r="6" fill="currentColor" opacity="0.7"/>
        <circle cx="103" cy="81" r="6" fill="currentColor" opacity="0.7"/>
        <circle cx="60" cy="106" r="6" fill="currentColor" opacity="0.7"/>
        <circle cx="17" cy="81" r="6" fill="currentColor" opacity="0.7"/>
        <circle cx="17" cy="31" r="6" fill="currentColor" opacity="0.7"/>
      </svg>
      <span class="logo-text">Matter Learn</span>
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav">
      {navigation.map((item) =>
        item.children ? (
          <div class:list={['dropdown', { 'mega': item.megaMenu }]}>
            <button
              class:list={['nav-item', 'dropdown-trigger', { active: isDropdownActive(item, pathForActive) }]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.title}
              <ChevronDown class="chevron" size={12} />
            </button>
            <div class:list={['dropdown-menu', { 'mega-menu': item.megaMenu }]}>
              {item.children.map((child) => (
                <Fragment>
                  {child.dividerBefore && <div class="dropdown-divider"></div>}
                  {child.group ? (
                    <div class="dropdown-group">{child.title}</div>
                  ) : (
                    <a
                      href={child.href}
                      class:list={['dropdown-item', { active: !child.external && isActive(child.href, pathForActive) }]}
                      {...(child.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      <span>{child.title}</span>
                      {child.external && (
                        <ArrowUpRight class="external-icon" size={12} strokeWidth={1.5} />
                      )}
                    </a>
                  )}
                </Fragment>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={['nav-item', { active: isActive(item.href, pathForActive) }]}
          >
            {item.title}
          </a>
        )
      )}
    </nav>

    <!-- Right side: language switch + theme toggle + mobile hamburger -->
    <div class="header-right">
      <a href={altPath} class="lang-btn" aria-label={t(lang, 'header.switchLangLabel')} data-lang-switch>
        <Globe size={15} />
        <span>{t(lang, 'header.switchLang')}</span>
      </a>
      <button id="theme-toggle" class="icon-btn" aria-label={t(lang, 'header.toggleTheme')}>
        <Sun id="sun-icon" size={18} />
        <Moon id="moon-icon" size={18} style="display:none;" />
      </button>
      <button id="mobile-menu-toggle" class="icon-btn mobile-only" aria-label={t(lang, 'header.toggleMenu')} aria-expanded="false">
        <Menu id="hamburger-icon" size={20} />
        <X id="close-icon" size={20} style="display:none;" />
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav" class="mobile-nav">
    {navigation.map((item) =>
      item.children ? (
        <div class="mobile-section">
          <button class="mobile-section-toggle" data-expanded="false">
            <span>{item.title}</span>
            <ChevronDown class="mobile-chevron" size={14} />
          </button>
          <div class="mobile-section-children">
            {item.children.map((child) => (
              <Fragment>
                {child.dividerBefore && <div class="mobile-divider"></div>}
                {child.group ? (
                  <div class="mobile-group">{child.title}</div>
                ) : (
                  <a
                    href={child.href}
                    class:list={['mobile-link', 'mobile-child', { active: !child.external && isActive(child.href, pathForActive) }]}
                    {...(child.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <span>{child.title}</span>
                    {child.external && (
                      <ArrowUpRight class="external-icon" size={12} strokeWidth={1.5} />
                    )}
                  </a>
                )}
              </Fragment>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class:list={['mobile-link', { active: isActive(item.href, pathForActive) }]}
        >
          {item.title}
        </a>
      )
    )}
    <!-- Mobile language switch -->
    <div class="mobile-divider" style="margin: 0.5rem 0;"></div>
    <a href={altPath} class="mobile-link" data-lang-switch>
      <span>{lang === 'zh' ? 'English' : '中文'}</span>
      <Globe size={14} />
    </a>
  </div>
</header>

<script>
function updateThemeIcons() {
  const isDark = document.documentElement.classList.contains('dark');
  const sun = document.getElementById('sun-icon') as HTMLElement | null;
  const moon = document.getElementById('moon-icon') as HTMLElement | null;
  if (sun && moon) {
    sun.style.display = isDark ? 'none' : 'block';
    moon.style.display = isDark ? 'block' : 'none';
  }
}

let docClickAc: AbortController | undefined;

document.addEventListener('astro:page-load', () => {
  updateThemeIcons();

  // Language preference
  document.querySelectorAll('[data-lang-switch]').forEach((el) => {
    el.addEventListener('click', () => {
      const href = el.getAttribute('href') || '';
      const m = href.match(/^\/(zh|en)\//);
      if (m) { try { localStorage.setItem('preferredLang', m[1]); } catch {} }
    });
  });

  // Theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    document.documentElement.classList.toggle('dark');
    const isDark = document.documentElement.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateThemeIcons();
  });

  // Mobile menu
  const mobileBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const hamburger = document.getElementById('hamburger-icon') as HTMLElement | null;
  const closeBtn = document.getElementById('close-icon') as HTMLElement | null;
  if (mobileBtn && mobileNav) {
    mobileNav.classList.remove('open');
    mobileBtn.setAttribute('aria-expanded', 'false');
    if (hamburger) hamburger.style.display = 'block';
    if (closeBtn) closeBtn.style.display = 'none';
    mobileBtn.addEventListener('click', () => {
      const isOpen = mobileNav.classList.toggle('open');
      mobileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      if (hamburger) hamburger.style.display = isOpen ? 'none' : 'block';
      if (closeBtn) closeBtn.style.display = isOpen ? 'block' : 'none';
    });
  }

  // Mobile section toggles
  document.querySelectorAll('.mobile-section-toggle').forEach((btn) => {
    btn.addEventListener('click', function (this: HTMLElement) {
      const expanded = this.getAttribute('data-expanded') === 'true';
      this.setAttribute('data-expanded', expanded ? 'false' : 'true');
      this.classList.toggle('expanded');
      const children = this.nextElementSibling as HTMLElement | null;
      if (children) children.classList.toggle('open');
    });
  });

  // Desktop dropdown hover
  document.querySelectorAll('.dropdown').forEach((dropdown) => {
    const trigger = dropdown.querySelector('.dropdown-trigger');
    dropdown.addEventListener('mouseenter', () => {
      trigger?.setAttribute('aria-expanded', 'true');
      dropdown.classList.add('open');
    });
    dropdown.addEventListener('mouseleave', () => {
      trigger?.setAttribute('aria-expanded', 'false');
      dropdown.classList.remove('open');
    });
    trigger?.addEventListener('click', (e) => {
      e.preventDefault();
      const isOpen = dropdown.classList.toggle('open');
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });

  // Close dropdowns on outside click (one listener on document, replaced each nav)
  if (docClickAc) docClickAc.abort();
  docClickAc = new AbortController();
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.dropdown.open').forEach((d) => {
      if (!d.contains(e.target as Node)) {
        d.classList.remove('open');
        d.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
      }
    });
  }, { signal: docClickAc.signal });
});
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(12px);
    background-color: color-mix(in srgb, var(--bg-primary), transparent 5%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 1.5rem;
    max-width: 80rem;
    margin: 0 auto;
    gap: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .logo-icon {
    color: var(--color-primary-600, #4f46e5);
  }

  :global(.dark) .logo-icon {
    color: var(--color-primary-400, #818cf8);
  }

  .logo-text {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    border: none;
    background: none;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
    font-family: inherit;
  }

  .nav-item:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .nav-item.active {
    color: var(--color-primary-600, #4f46e5);
  }

  :global(.dark) .nav-item.active {
    color: var(--color-primary-400, #818cf8);
  }

  .chevron {
    transition: transform 0.2s ease;
    opacity: 0.6;
  }

  .dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 200px;
    padding: 0.375rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08), 0 1px 4px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
    z-index: 60;
  }

  :global(.dark) .dropdown-menu {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3), 0 1px 4px rgba(0, 0, 0, 0.15);
  }

  .dropdown.open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown.open .chevron {
    transform: rotate(180deg);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.1s ease, color 0.1s ease;
  }

  .dropdown-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .dropdown-item.active {
    color: var(--color-primary-600, #4f46e5);
    background: var(--color-primary-50, #eef2ff);
  }

  :global(.dark) .dropdown-item.active {
    color: var(--color-primary-400, #818cf8);
    background: rgba(99, 102, 241, 0.1);
  }

  .dropdown-group {
    padding: 0.5rem 0.75rem 0.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-600, #4f46e5);
  }

  :global(.dark) .dropdown-group {
    color: var(--color-primary-400, #818cf8);
  }

  .dropdown-group:not(:first-child) {
    margin-top: 0.25rem;
    border-top: 1px solid var(--border-color);
    padding-top: 0.5rem;
  }

  .mega-menu {
    columns: 3;
    column-gap: 0.25rem;
    min-width: 540px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }

  .mega-menu .dropdown-group,
  .mega-menu .dropdown-item,
  .mega-menu .dropdown-divider {
    break-inside: avoid;
  }

  .dropdown-divider {
    height: 1px;
    margin: 0.25rem 0.5rem;
    background: var(--border-color);
  }

  .external-icon {
    flex-shrink: 0;
    opacity: 0.5;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    border: 1px solid var(--border-color);
    background: none;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    white-space: nowrap;
  }

  .lang-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
    border-color: var(--border-active);
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.375rem;
    border: none;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .icon-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .mobile-only {
    display: none;
  }

  .mobile-nav {
    display: none;
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    padding: 0.5rem 1rem 1rem;
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  :global(.dark) .mobile-nav {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .mobile-nav.open {
    display: block;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.1s ease;
  }

  .mobile-link:hover {
    background: var(--bg-hover);
  }

  .mobile-link.active {
    color: var(--color-primary-600, #4f46e5);
    background: var(--color-primary-50, #eef2ff);
  }

  :global(.dark) .mobile-link.active {
    color: var(--color-primary-400, #818cf8);
    background: rgba(99, 102, 241, 0.1);
  }

  .mobile-child {
    padding-left: 1.5rem;
    font-size: 0.875rem;
  }

  .mobile-section-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    font-family: inherit;
    transition: background-color 0.1s ease;
  }

  .mobile-section-toggle:hover {
    background: var(--bg-hover);
  }

  .mobile-chevron {
    transition: transform 0.2s ease;
    opacity: 0.5;
  }

  .mobile-section-toggle.expanded .mobile-chevron {
    transform: rotate(180deg);
  }

  .mobile-section-children {
    display: none;
    padding-bottom: 0.25rem;
  }

  .mobile-section-children.open {
    display: block;
  }

  .mobile-group {
    padding: 0.5rem 1.5rem 0.125rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-600, #4f46e5);
  }

  :global(.dark) .mobile-group {
    color: var(--color-primary-400, #818cf8);
  }

  .mobile-group:not(:first-child) {
    margin-top: 0.25rem;
    border-top: 1px solid var(--border-color);
    padding-top: 0.5rem;
  }

  .mobile-divider {
    height: 1px;
    margin: 0.25rem 1.5rem;
    background: var(--border-color);
  }

  @media (max-width: 768px) {
    .header-inner {
      padding: 0 1rem;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-only {
      display: flex;
    }
  }
</style>
