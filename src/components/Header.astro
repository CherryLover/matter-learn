---
import { Layers, ChevronDown, ArrowUpRight, Sun, Moon, Menu, X } from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

interface NavItem {
  title: string;
  href?: string;
  external?: boolean;
  children?: NavItem[];
  dividerBefore?: boolean;
  megaMenu?: boolean;
  group?: boolean;
}

const navigation: NavItem[] = [
  { title: '首页', href: '/' },
  { title: '概念总览', href: '/concepts/' },
  {
    title: 'Cluster 手册',
    megaMenu: true,
    children: [
      { title: '照明控制', group: true },
      { title: '开关 OnOff', href: '/clusters/on-off/' },
      { title: '亮度 LevelControl', href: '/clusters/level-control/' },
      { title: '颜色 ColorControl', href: '/clusters/color-control/' },
      { title: '闭合设备', group: true },
      { title: '门锁 DoorLock', href: '/clusters/door-lock/' },
      { title: '窗帘 WindowCovering', href: '/clusters/window-covering/' },
      { title: '阀门 ValveConfig', href: '/clusters/valve-configuration-and-control/' },
      { title: '暖通空调', group: true },
      { title: '温控 Thermostat', href: '/clusters/thermostat/' },
      { title: '风扇 FanControl', href: '/clusters/fan-control/' },
      { title: '传感与测量', group: true },
      { title: '温度 Temperature', href: '/clusters/temperature-measurement/' },
      { title: '湿度 Humidity', href: '/clusters/relative-humidity-measurement/' },
      { title: '占位 Occupancy', href: '/clusters/occupancy-sensing/' },
      { title: '空气 AirQuality', href: '/clusters/air-quality/' },
      { title: '安防与输入', group: true },
      { title: '烟感 SmokeCOAlarm', href: '/clusters/smoke-co-alarm/' },
      { title: '布尔 BooleanState', href: '/clusters/boolean-state/' },
      { title: '家电', group: true },
      { title: '运行状态 OperationalState', href: '/clusters/operational-state/' },
      { title: '洗衣机 LaundryWasher', href: '/clusters/laundry-washer-mode/' },
      { title: '扫地机 RvcRunMode', href: '/clusters/rvc-run-mode/' },
      { title: '媒体', group: true },
      { title: '播放 MediaPlayback', href: '/clusters/media-playback/' },
      { title: '频道 Channel', href: '/clusters/channel/' },
      { title: '通用功能', group: true },
      { title: '标识 Identify', href: '/clusters/identify/' },
      { title: '描述 Descriptor', href: '/clusters/descriptor/' },
      { title: '权限 AccessControl', href: '/clusters/access-control/' },
      { title: '节点与配置', group: true },
      { title: '基本信息 BasicInfo', href: '/clusters/basic-information/' },
      { title: '电源 PowerSource', href: '/clusters/power-source/' },
      { title: '时间 TimeSynchronization', href: '/clusters/time-synchronization/' },
      { title: '配网与安全', group: true },
      { title: '网络配置 NetworkComm', href: '/clusters/network-commissioning/' },
      { title: '凭据 OperationalCred', href: '/clusters/operational-credentials/' },
      { title: 'OTA 与诊断', group: true },
      { title: 'OTA Provider', href: '/clusters/ota-software-update-provider/' },
      { title: '通用诊断 GeneralDiag', href: '/clusters/general-diagnostics/' },
      { title: '能源管理', group: true },
      { title: '电功率 ElecPower', href: '/clusters/electrical-power-measurement/' },
      { title: '查看全部 82 个 Cluster', href: '/clusters/', dividerBefore: true },
    ],
  },
  {
    title: '数据工具',
    children: [
      { title: 'JSON 解析器', href: '/tools/json-parser/' },
    ],
  },
  {
    title: '官方标准',
    children: [
      { title: 'CSA 官网', href: 'https://csa-iot.org/', external: true },
      { title: 'Matter 规范', href: 'https://csa-iot.org/all-solutions/matter/', external: true },
      { title: 'Matter GitHub', href: 'https://github.com/project-chip/connectedhomeip', external: true },
      { title: 'Device Library', href: 'https://csa-iot.org/csa-iot/csa-device-library/', external: true },
    ],
  },
];

function isActive(href: string | undefined, current: string): boolean {
  if (!href) return false;
  if (href === '/') return current === '/';
  return current.startsWith(href);
}

function isDropdownActive(item: NavItem, current: string): boolean {
  if (item.children) {
    return item.children.some(child => !child.external && isActive(child.href, current));
  }
  return false;
}
---

<header class="header">
  <div class="header-inner">
    <!-- Logo -->
    <a href="/" class="logo">
      <Layers size={24} class="logo-icon" />
      <span class="logo-text">Matter Learn</span>
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav">
      {navigation.map((item) =>
        item.children ? (
          <div class:list={['dropdown', { 'mega': item.megaMenu }]}>
            <button
              class:list={['nav-item', 'dropdown-trigger', { active: isDropdownActive(item, currentPath) }]}
              aria-haspopup="true"
              aria-expanded="false"
            >
              {item.title}
              <ChevronDown class="chevron" size={12} />
            </button>
            <div class:list={['dropdown-menu', { 'mega-menu': item.megaMenu }]}>
              {item.children.map((child) => (
                <Fragment>
                  {child.dividerBefore && <div class="dropdown-divider"></div>}
                  {child.group ? (
                    <div class="dropdown-group">{child.title}</div>
                  ) : (
                    <a
                      href={child.href}
                      class:list={['dropdown-item', { active: !child.external && isActive(child.href, currentPath) }]}
                      {...(child.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      <span>{child.title}</span>
                      {child.external && (
                        <ArrowUpRight class="external-icon" size={12} strokeWidth={1.5} />
                      )}
                    </a>
                  )}
                </Fragment>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={['nav-item', { active: isActive(item.href, currentPath) }]}
          >
            {item.title}
          </a>
        )
      )}
    </nav>

    <!-- Right side: theme toggle + mobile hamburger -->
    <div class="header-right">
      <button id="theme-toggle" class="icon-btn" aria-label="Toggle theme">
        <Sun id="sun-icon" size={18} />
        <Moon id="moon-icon" size={18} style="display:none;" />
      </button>
      <button id="mobile-menu-toggle" class="icon-btn mobile-only" aria-label="Toggle menu" aria-expanded="false">
        <Menu id="hamburger-icon" size={20} />
        <X id="close-icon" size={20} style="display:none;" />
      </button>
    </div>
  </div>

  <!-- Mobile nav panel -->
  <div id="mobile-nav" class="mobile-nav">
    {navigation.map((item) =>
      item.children ? (
        <div class="mobile-section">
          <button class="mobile-section-toggle" data-expanded="false">
            <span>{item.title}</span>
            <ChevronDown class="mobile-chevron" size={14} />
          </button>
          <div class="mobile-section-children">
            {item.children.map((child) => (
              <Fragment>
                {child.dividerBefore && <div class="mobile-divider"></div>}
                {child.group ? (
                  <div class="mobile-group">{child.title}</div>
                ) : (
                  <a
                    href={child.href}
                    class:list={['mobile-link', 'mobile-child', { active: !child.external && isActive(child.href, currentPath) }]}
                    {...(child.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    <span>{child.title}</span>
                    {child.external && (
                      <ArrowUpRight class="external-icon" size={12} strokeWidth={1.5} />
                    )}
                  </a>
                )}
              </Fragment>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={item.href}
          class:list={['mobile-link', { active: isActive(item.href, currentPath) }]}
        >
          {item.title}
        </a>
      )
    )}
  </div>
</header>

<script is:inline>
(function() {
  // Theme
  const theme = localStorage.getItem('theme') ||
    (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  if (theme === 'dark') {
    document.documentElement.classList.add('dark');
  }
  updateThemeIcons();

  document.addEventListener('DOMContentLoaded', function() {
    // Theme toggle
    var toggle = document.getElementById('theme-toggle');
    if (toggle) {
      toggle.addEventListener('click', function() {
        document.documentElement.classList.toggle('dark');
        var isDark = document.documentElement.classList.contains('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateThemeIcons();
      });
    }

    // Mobile menu toggle
    var mobileBtn = document.getElementById('mobile-menu-toggle');
    var mobileNav = document.getElementById('mobile-nav');
    var hamburger = document.getElementById('hamburger-icon');
    var closeBtn = document.getElementById('close-icon');
    if (mobileBtn && mobileNav) {
      mobileBtn.addEventListener('click', function() {
        var isOpen = mobileNav.classList.toggle('open');
        mobileBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (hamburger) hamburger.style.display = isOpen ? 'none' : 'block';
        if (closeBtn) closeBtn.style.display = isOpen ? 'block' : 'none';
      });
    }

    // Mobile section toggles
    document.querySelectorAll('.mobile-section-toggle').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var expanded = this.getAttribute('data-expanded') === 'true';
        this.setAttribute('data-expanded', expanded ? 'false' : 'true');
        this.classList.toggle('expanded');
        var children = this.nextElementSibling;
        if (children) children.classList.toggle('open');
      });
    });

    // Desktop dropdown: open on hover, close when leaving
    document.querySelectorAll('.dropdown').forEach(function(dropdown) {
      var trigger = dropdown.querySelector('.dropdown-trigger');
      var menu = dropdown.querySelector('.dropdown-menu');

      dropdown.addEventListener('mouseenter', function() {
        if (trigger) trigger.setAttribute('aria-expanded', 'true');
        dropdown.classList.add('open');
      });
      dropdown.addEventListener('mouseleave', function() {
        if (trigger) trigger.setAttribute('aria-expanded', 'false');
        dropdown.classList.remove('open');
      });

      // Also handle click for accessibility
      if (trigger) {
        trigger.addEventListener('click', function(e) {
          e.preventDefault();
          var isOpen = dropdown.classList.toggle('open');
          trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        });
      }
    });

    // Close dropdowns when clicking outside
    document.addEventListener('click', function(e) {
      document.querySelectorAll('.dropdown.open').forEach(function(d) {
        if (!d.contains(e.target)) {
          d.classList.remove('open');
          var t = d.querySelector('.dropdown-trigger');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });

  function updateThemeIcons() {
    var isDark = document.documentElement.classList.contains('dark');
    var sun = document.getElementById('sun-icon');
    var moon = document.getElementById('moon-icon');
    if (sun && moon) {
      sun.style.display = isDark ? 'none' : 'block';
      moon.style.display = isDark ? 'block' : 'none';
    }
  }
})();
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    height: 60px;
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    backdrop-filter: blur(12px);
    background-color: color-mix(in srgb, var(--bg-primary), transparent 5%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 1.5rem;
    max-width: 80rem;
    margin: 0 auto;
    gap: 2rem;
  }

  /* Logo */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .logo-icon {
    color: var(--color-primary-600, #4f46e5);
  }

  :global(.dark) .logo-icon {
    color: var(--color-primary-400, #818cf8);
  }

  .logo-text {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  /* Desktop nav */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
  }

  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    border: none;
    background: none;
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
    white-space: nowrap;
    font-family: inherit;
  }

  .nav-item:hover {
    color: var(--text-primary);
    background: var(--bg-hover);
  }

  .nav-item.active {
    color: var(--color-primary-600, #4f46e5);
  }

  :global(.dark) .nav-item.active {
    color: var(--color-primary-400, #818cf8);
  }

  .chevron {
    transition: transform 0.2s ease;
    opacity: 0.6;
  }

  /* Dropdown */
  .dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 200px;
    padding: 0.375rem;
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08), 0 1px 4px rgba(0, 0, 0, 0.04);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
    z-index: 60;
  }

  :global(.dark) .dropdown-menu {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3), 0 1px 4px rgba(0, 0, 0, 0.15);
  }

  .dropdown.open .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown.open .chevron {
    transform: rotate(180deg);
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.1s ease, color 0.1s ease;
  }

  .dropdown-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .dropdown-item.active {
    color: var(--color-primary-600, #4f46e5);
    background: var(--color-primary-50, #eef2ff);
  }

  :global(.dark) .dropdown-item.active {
    color: var(--color-primary-400, #818cf8);
    background: rgba(99, 102, 241, 0.1);
  }

  .dropdown-group {
    padding: 0.5rem 0.75rem 0.25rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-600, #4f46e5);
  }

  :global(.dark) .dropdown-group {
    color: var(--color-primary-400, #818cf8);
  }

  .dropdown-group:not(:first-child) {
    margin-top: 0.25rem;
    border-top: 1px solid var(--border-color);
    padding-top: 0.5rem;
  }

  .mega-menu {
    columns: 3;
    column-gap: 0.25rem;
    min-width: 540px;
    max-height: calc(100vh - 80px);
    overflow-y: auto;
  }

  .mega-menu .dropdown-group,
  .mega-menu .dropdown-item,
  .mega-menu .dropdown-divider {
    break-inside: avoid;
  }

  .dropdown-divider {
    height: 1px;
    margin: 0.25rem 0.5rem;
    background: var(--border-color);
  }

  .external-icon {
    flex-shrink: 0;
    opacity: 0.5;
  }

  /* Header right */
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.375rem;
    border: none;
    background: none;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .icon-btn:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .mobile-only {
    display: none;
  }

  /* Mobile nav panel */
  .mobile-nav {
    display: none;
    position: absolute;
    top: 60px;
    left: 0;
    right: 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    padding: 0.5rem 1rem 1rem;
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  :global(.dark) .mobile-nav {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .mobile-nav.open {
    display: block;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: 0.375rem;
    transition: background-color 0.1s ease;
  }

  .mobile-link:hover {
    background: var(--bg-hover);
  }

  .mobile-link.active {
    color: var(--color-primary-600, #4f46e5);
    background: var(--color-primary-50, #eef2ff);
  }

  :global(.dark) .mobile-link.active {
    color: var(--color-primary-400, #818cf8);
    background: rgba(99, 102, 241, 0.1);
  }

  .mobile-child {
    padding-left: 1.5rem;
    font-size: 0.875rem;
  }

  .mobile-section-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.625rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    background: none;
    border: none;
    border-radius: 0.375rem;
    cursor: pointer;
    font-family: inherit;
    transition: background-color 0.1s ease;
  }

  .mobile-section-toggle:hover {
    background: var(--bg-hover);
  }

  .mobile-chevron {
    transition: transform 0.2s ease;
    opacity: 0.5;
  }

  .mobile-section-toggle.expanded .mobile-chevron {
    transform: rotate(180deg);
  }

  .mobile-section-children {
    display: none;
    padding-bottom: 0.25rem;
  }

  .mobile-section-children.open {
    display: block;
  }

  .mobile-group {
    padding: 0.5rem 1.5rem 0.125rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary-600, #4f46e5);
  }

  :global(.dark) .mobile-group {
    color: var(--color-primary-400, #818cf8);
  }

  .mobile-group:not(:first-child) {
    margin-top: 0.25rem;
    border-top: 1px solid var(--border-color);
    padding-top: 0.5rem;
  }

  .mobile-divider {
    height: 1px;
    margin: 0.25rem 1.5rem;
    background: var(--border-color);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .header-inner {
      padding: 0 1rem;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-only {
      display: flex;
    }
  }
</style>
