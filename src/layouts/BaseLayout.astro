---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromPath, localePath, getAlternateLang, type Lang } from '../i18n/config';
import { t } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
  type?: 'website' | 'article';
  lang?: Lang;
  /** Absolute or site-relative canonical URL; defaults to the current page */
  canonical?: string;
  /** Error pages etc.: emit robots noindex and skip canonical/hreflang */
  noindex?: boolean;
}

const currentPath = Astro.url.pathname;
const lang = Astro.props.lang ?? getLangFromPath(currentPath);
const altLang = getAlternateLang(lang);
const defaultDescription = t(lang, 'meta.defaultDescription');

const { title, description = defaultDescription, fullWidth = false, type = 'website', canonical, noindex = false } = Astro.props;
const canonicalURL = new URL(canonical ?? currentPath, Astro.site);
const altURL = new URL(localePath(altLang, currentPath), Astro.site);
const fullTitle = `${title} | Matter Learn`;

const htmlLang = lang === 'zh' ? 'zh-CN' : 'en';
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const ogLocaleAlt = lang === 'zh' ? 'en_US' : 'zh_CN';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebSite',
  name: fullTitle,
  description,
  url: canonicalURL.href,
  ...(type === 'website' && { potentialAction: { '@type': 'SearchAction', target: `${Astro.site}${lang}/clusters/`, 'query-input': 'required name=search_term_string' } }),
  inLanguage: htmlLang,
  publisher: {
    '@type': 'Organization',
    name: 'Matter Learn',
    url: Astro.site?.href,
  },
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonicalURL.href} />

        <!-- hreflang alternates -->
        <link rel="alternate" hreflang="zh" href={new URL(localePath('zh', currentPath), Astro.site).href} />
        <link rel="alternate" hreflang="en" href={new URL(localePath('en', currentPath), Astro.site).href} />
        <link rel="alternate" hreflang="x-default" href={new URL(localePath('zh', currentPath), Astro.site).href} />
      </>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:site_name" content="Matter Learn" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={`${Astro.site}og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${Astro.site}og-image.png`} />

    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <ClientRouter />

    <!-- Umami Analytics -->
    <script defer src="https://stats.flyooo.uk/script.js" data-website-id="8c8528c7-0798-4425-986f-98fe0f93f548"></script>
    <script defer src="https://stats.flyooo.uk/recorder.js" data-website-id="8c8528c7-0798-4425-986f-98fe0f93f548"></script>

    <!-- Theme persistence: runs once in head, persists across client-side navigations -->
    <script is:inline>
    (function() {
      function applyTheme() {
        var theme = localStorage.getItem('theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.classList.toggle('dark', theme === 'dark');
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    })();
    </script>
  </head>
  <body>
    <Header currentPath={currentPath} lang={lang} />
    <main class:list={['main-content', { 'main-full': fullWidth }]}>
      <slot />
    </main>
    <Footer lang={lang} />

    <button id="back-to-top" class="back-to-top" aria-label={t(lang, 'backToTop')}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <script>
    let scrollAc: AbortController | undefined;
    document.addEventListener('astro:page-load', () => {
      if (scrollAc) scrollAc.abort();
      scrollAc = new AbortController();
      const btn = document.getElementById('back-to-top');
      if (!btn) return;
      let shown = false;
      function toggle() {
        const shouldShow = window.scrollY > 400;
        if (shouldShow !== shown) {
          shown = shouldShow;
          btn!.classList.toggle('visible', shown);
        }
      }
      window.addEventListener('scroll', toggle, { passive: true, signal: scrollAc.signal });
      btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      toggle();
    });
    </script>
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .main-content {
    margin-top: 60px;
    flex: 1;
    width: 100%;
    max-width: 72rem;
    margin-left: auto;
    margin-right: auto;
    padding: 2rem 1.5rem;
  }

  .main-content.main-full {
    max-width: 100%;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (max-width: 768px) {
    .main-content {
      padding: 1.5rem 1rem;
    }
  }
</style>

<style is:global>
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--border-color);
    background: var(--bg-primary);
    color: var(--text-secondary);
    cursor: pointer;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease,
                background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .back-to-top:hover {
    color: var(--text-primary);
    border-color: var(--border-active);
    background: var(--bg-hover);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  @media (max-width: 768px) {
    .back-to-top {
      bottom: 1.25rem;
      right: 1.25rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
