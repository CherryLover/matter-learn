---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="您访问的页面不存在">
  <div class="not-found">
    <span class="code">404</span>
    <h1>页面未找到</h1>
    <p>你访问的页面不存在或已被移动。</p>
    <div class="actions">
      <a href="/" class="btn btn-primary">回到首页</a>
      <a href="/clusters/" class="btn btn-secondary">Cluster 手册</a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 50vh;
    padding: 2rem;
  }

  .code {
    font-size: 6rem;
    font-weight: 800;
    color: var(--color-primary-600, #4f46e5);
    opacity: 0.15;
    line-height: 1;
    margin-bottom: -0.5rem;
  }

  :global(.dark) .code {
    color: var(--color-primary-400, #818cf8);
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  p {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary-600, #4f46e5);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-primary-700, #4338ca);
  }

  .btn-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-secondary:hover {
    background: var(--bg-hover);
  }
</style>
