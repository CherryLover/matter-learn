---
import DocLayout from '../../../layouts/DocLayout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../../i18n/config';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const text = lang === 'en'
  ? (await import('../../../i18n/en/pages/faq')).default
  : (await import('../../../i18n/zh/pages/faq')).default;

// 搜索引擎识别的 FAQ 结构化数据
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: text.groups.flatMap((g) =>
    g.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    }))
  ),
};
---

<DocLayout
  title={text.title}
  description={text.description}
  lang={lang}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <h1>{text.heading}</h1>
  <p>{text.intro}</p>

  <div class="faq-toolbar">
    <nav class="faq-groups">
      {text.groups.map((g) => (
        <a href={`#${g.id}`} class="faq-chip">
          {g.title}
          <span class="faq-chip-count">{g.items.length}</span>
        </a>
      ))}
    </nav>
    <div class="faq-toggle">
      <button type="button" data-faq-toggle="open">{text.expandAll}</button>
      <button type="button" data-faq-toggle="close">{text.collapseAll}</button>
    </div>
  </div>

  {text.groups.map((g) => (
    <section class="faq-group">
      <h2 id={g.id}>{g.title}</h2>
      {g.items.map((item) => (
        <details class="faq-item" id={item.id}>
          <summary>
            <span class="faq-q">{item.q}</span>
            <a class="faq-anchor" href={`#${item.id}`} aria-label="#">#</a>
          </summary>
          <div class="faq-a">
            <p>{item.a}</p>
            <a class="faq-more" href={item.link.href}>{text.detailLabel}：{item.link.label} →</a>
          </div>
        </details>
      ))}
    </section>
  ))}
</DocLayout>

<script>
  // 带锚点进入（例如从底部栏点某个问题）时，自动展开并定位到该问题
  function openFromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const el = document.getElementById(id);
    if (el instanceof HTMLDetailsElement) {
      el.open = true;
      el.scrollIntoView({ block: 'start' });
    }
  }
  openFromHash();
  window.addEventListener('hashchange', openFromHash);

  document.querySelectorAll<HTMLButtonElement>('[data-faq-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const open = btn.dataset.faqToggle === 'open';
      document.querySelectorAll<HTMLDetailsElement>('.faq-item').forEach((d) => (d.open = open));
    });
  });
</script>

<style>
  .faq-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1.25rem 0 0.5rem;
  }

  .faq-groups {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .faq-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    text-decoration: none;
  }

  .faq-chip:hover {
    color: var(--text-primary);
    border-color: var(--border-active);
  }

  .faq-chip-count {
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  .faq-toggle {
    display: flex;
    gap: 0.5rem;
  }

  .faq-toggle button {
    font: inherit;
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--border-color);
    border-radius: 0.375rem;
    background: var(--bg-primary);
    color: var(--text-secondary);
    cursor: pointer;
  }

  .faq-toggle button:hover {
    border-color: var(--border-active);
    color: var(--text-primary);
  }

  .faq-group h2 {
    scroll-margin-top: 5rem;
  }

  .faq-item {
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    margin: 0.5rem 0;
    background: var(--bg-primary);
    scroll-margin-top: 5rem;
  }

  .faq-item[open] {
    border-color: var(--border-active);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--text-primary);
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::before {
    content: '+';
    flex-shrink: 0;
    width: 1.25rem;
    text-align: center;
    font-family: var(--font-mono);
    color: var(--color-primary-600, #4f46e5);
  }

  .faq-item[open] summary::before {
    content: '−';
  }

  .faq-q {
    flex: 1;
  }

  .faq-anchor {
    font-weight: 400;
    color: var(--text-muted);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .faq-item summary:hover .faq-anchor,
  .faq-anchor:focus {
    opacity: 1;
  }

  .faq-a {
    padding: 0 1rem 0.875rem 3rem;
  }

  .faq-a p {
    margin: 0 0 0.5rem;
    color: var(--text-secondary);
  }

  .faq-more {
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .faq-a {
      padding-left: 1rem;
    }
  }
</style>
