---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BookOpen, Wrench, Code, MessageSquare, Users, SearchCode, Smartphone, Milestone, Library } from 'lucide-astro';
import { SUPPORTED_LANGS, localePath, type Lang } from '../../i18n/config';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const lp = (path: string) => localePath(lang, path);

// Dynamically import the correct translations
const homeText = lang === 'en'
  ? (await import('../../i18n/en/pages/home')).default
  : (await import('../../i18n/zh/pages/home')).default;

// Site-wide numbers, derived from the data files so they never go stale
const clusterIndex = (await import('../../i18n/zh/pages/cluster-index')).default;
const sdkText = (await import('../../i18n/zh/pages/sdk')).default;
const roadmapText = (await import('../../i18n/zh/pages/roadmap')).default;
const stats = {
  clusters: clusterIndex.categories.reduce((n: number, c: any) => n + c.clusters.length, 0),
  categories: clusterIndex.categories.length,
  platforms: sdkText.platforms.length,
  versionRange: `${roadmapText.versions[roadmapText.versions.length - 1].version} – ${roadmapText.timelineContext.latestSpec}`,
};
const clusterDesc = homeText.featureClusterDesc
  .replace('{count}', String(stats.clusters))
  .replace('{categories}', String(stats.categories));
---

<BaseLayout title={homeText.title} description={homeText.description} lang={lang}>
  <div class="hero">
    <div class="hero-badge">{homeText.heroBadge}</div>
    <h1 class="hero-title">{homeText.heroTitle}</h1>
    <p class="hero-desc" set:html={homeText.heroDesc} />
    <div class="hero-actions">
      <a href={lp('/concepts/')} class="btn btn-primary">{homeText.heroStartLearning}</a>
      <a href={lp('/clusters/')} class="btn btn-secondary">{homeText.heroClusterManual}</a>
    </div>
  </div>

  <figure class="diagram hero-diagram">
    <img src={`/images/diagrams/interop-${lang}.webp`} alt={homeText.heroDiagramAlt} width="1536" height="1024" fetchpriority="high" decoding="async" />
  </figure>

  <div class="stats">
    <div class="stat">
      <span class="stat-value">{stats.clusters}</span>
      <span class="stat-label">{homeText.statClusters}</span>
    </div>
    <div class="stat">
      <span class="stat-value">{stats.categories}</span>
      <span class="stat-label">{homeText.statCategories}</span>
    </div>
    <div class="stat">
      <span class="stat-value">{stats.platforms}</span>
      <span class="stat-label">{homeText.statPlatforms}</span>
    </div>
    <div class="stat">
      <span class="stat-value">{stats.versionRange}</span>
      <span class="stat-label">{homeText.statVersions}</span>
    </div>
  </div>

  <div class="features">
    <a href={lp('/concepts/')} class="feature-card">
      <div class="feature-icon">
        <BookOpen size={24} />
      </div>
      <h3 class="feature-title">{homeText.featureConceptsTitle}</h3>
      <p class="feature-desc">{homeText.featureConceptsDesc}</p>
    </a>

    <a href={lp('/clusters/')} class="feature-card">
      <div class="feature-icon">
        <Wrench size={24} />
      </div>
      <h3 class="feature-title">{homeText.featureClusterTitle}</h3>
      <p class="feature-desc">{clusterDesc}</p>
    </a>

    <a href={lp('/tools/json-parser/')} class="feature-card">
      <div class="feature-icon">
        <Code size={24} />
      </div>
      <h3 class="feature-title">{homeText.featureToolsTitle}</h3>
      <p class="feature-desc">{homeText.featureToolsDesc}</p>
    </a>

    <a href={lp('/sdk/')} class="feature-card">
      <div class="feature-icon">
        <Smartphone size={24} />
      </div>
      <h3 class="feature-title">{homeText.featureSdkTitle}</h3>
      <p class="feature-desc">{homeText.featureSdkDesc}</p>
    </a>

    <a href={lp('/roadmap/')} class="feature-card">
      <div class="feature-icon">
        <Milestone size={24} />
      </div>
      <h3 class="feature-title">{homeText.featureRoadmapTitle}</h3>
      <p class="feature-desc">{homeText.featureRoadmapDesc}</p>
    </a>

    <a href={lp('/resources/')} class="feature-card">
      <div class="feature-icon">
        <Library size={24} />
      </div>
      <h3 class="feature-title">{homeText.featureResourcesTitle}</h3>
      <p class="feature-desc">{homeText.featureResourcesDesc}</p>
    </a>
  </div>

  <div class="roadmap-section">
    <h2 class="section-heading">{homeText.roadmapTitle}</h2>
    <p class="section-subheading">{homeText.roadmapSubtitle}</p>

    <div class="roadmap">
      <div class="roadmap-line" aria-hidden="true"></div>

      <div class="roadmap-step">
        <div class="step-circle">1</div>
        <div class="step-content">
          <h4>{homeText.step1Title}</h4>
          <p>{homeText.step1Desc}</p>
          <a href={lp('/concepts/')} class="rm-link">{homeText.step1Link}</a>
        </div>
      </div>

      <div class="roadmap-step">
        <div class="step-circle">2</div>
        <div class="step-content">
          <h4>{homeText.step2Title}</h4>
          <p>{homeText.step2Desc}</p>
          <a href={lp('/concepts/')} class="rm-link">{homeText.step2Link}</a>
        </div>
      </div>

      <div class="roadmap-step">
        <div class="step-circle">3</div>
        <div class="step-content">
          <h4>{homeText.step3Title}</h4>
          <p>{homeText.step3Desc}</p>
          <a href={lp('/clusters/door-lock/')} class="rm-link">{homeText.step3Link}</a>
        </div>
      </div>

      <div class="roadmap-step">
        <div class="step-circle">4</div>
        <div class="step-content">
          <h4>{homeText.step4Title}</h4>
          <p>{homeText.step4Desc}</p>
          <a href={lp('/tools/json-parser/')} class="rm-link">{homeText.step4Link}</a>
        </div>
      </div>

      <div class="roadmap-step">
        <div class="step-circle">5</div>
        <div class="step-content">
          <h4>{homeText.step5Title}</h4>
          <p>{homeText.step5Desc}</p>
          <a href={lp('/clusters/')} class="rm-link">{homeText.step5Link}</a>
        </div>
      </div>

      <div class="roadmap-step">
        <div class="step-circle">6</div>
        <div class="step-content">
          <h4>{homeText.step6Title}</h4>
          <p>{homeText.step6Desc}</p>
          <a href={lp('/sdk/')} class="rm-link">{homeText.step6Link}</a>
        </div>
      </div>

      <div class="roadmap-step">
        <div class="step-circle">7</div>
        <div class="step-content">
          <h4>{homeText.step7Title}</h4>
          <p>{homeText.step7Desc}</p>
          <a href={lp('/roadmap/')} class="rm-link">{homeText.step7Link}</a>
        </div>
      </div>
    </div>
  </div>

  <div class="quickref-section">
    <h2 class="section-heading">{homeText.quickrefTitle}</h2>
    <p class="section-subheading">{homeText.quickrefSubtitle}</p>

    <div class="quickref-card">
      <a href={lp('/concepts/')} class="qr-row">
        <span class="qr-want">{homeText.qr1Want}</span>
        <span class="qr-go">{homeText.qr1Go}</span>
      </a>
      <a href={lp('/clusters/')} class="qr-row">
        <span class="qr-want">{homeText.qr2Want}</span>
        <span class="qr-go">{homeText.qr2Go}</span>
      </a>
      <a href={lp('/clusters/door-lock/')} class="qr-row">
        <span class="qr-want">{homeText.qr3Want}</span>
        <span class="qr-go">{homeText.qr3Go}</span>
      </a>
      <a href={lp('/clusters/power-source/')} class="qr-row">
        <span class="qr-want">{homeText.qr4Want}</span>
        <span class="qr-go">{homeText.qr4Go}</span>
      </a>
      <a href={lp('/tools/json-parser/')} class="qr-row">
        <span class="qr-want">{homeText.qr5Want}</span>
        <span class="qr-go">{homeText.qr5Go}</span>
      </a>
      <a href={lp('/sdk/')} class="qr-row">
        <span class="qr-want">{homeText.qr7Want}</span>
        <span class="qr-go">{homeText.qr7Go}</span>
      </a>
      <a href={lp('/roadmap/')} class="qr-row">
        <span class="qr-want">{homeText.qr8Want}</span>
        <span class="qr-go">{homeText.qr8Go}</span>
      </a>
      <a href={lp('/resources/')} class="qr-row">
        <span class="qr-want">{homeText.qr9Want}</span>
        <span class="qr-go">{homeText.qr9Go}</span>
      </a>
      <a href="https://csa-iot.org/developer-resource/specifications-download-request/" class="qr-row" target="_blank" rel="noopener noreferrer">
        <span class="qr-want">{homeText.qr6Want}</span>
        <span class="qr-go">{homeText.qr6Go}</span>
      </a>
    </div>
  </div>

  <div class="why-section">
    <h2 class="why-title">{homeText.whyTitle}</h2>
    <div class="why-grid">
      <div class="why-card">
        <div class="why-icon">
          <MessageSquare size={48} strokeWidth={1.5} />
        </div>
        <h3>{homeText.why1Title}</h3>
        <p>{homeText.why1Desc}</p>
      </div>
      <div class="why-card">
        <div class="why-icon">
          <Users size={48} strokeWidth={1.5} />
        </div>
        <h3>{homeText.why2Title}</h3>
        <p>{homeText.why2Desc}</p>
      </div>
      <div class="why-card">
        <div class="why-icon">
          <SearchCode size={48} strokeWidth={1.5} />
        </div>
        <h3>{homeText.why3Title}</h3>
        <p>{homeText.why3Desc}</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0 3rem;
    max-width: 40rem;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: var(--color-primary-50, #eef2ff);
    color: var(--color-primary-700, #4338ca);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  :global(.dark) .hero-badge {
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-primary-300, #a5b4fc);
  }

  .hero-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .hero-desc {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.8;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .btn-primary {
    background: var(--color-primary-600, #4f46e5);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-primary-700, #4338ca);
  }

  .btn-secondary {
    background: var(--bg-secondary);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .btn-secondary:hover {
    background: var(--bg-hover);
  }

  .hero-diagram {
    max-width: 44rem;
    margin: 0 auto;
  }

  .stats {
    display: flex;
    justify-content: center;
    align-items: stretch;
    gap: 0;
    max-width: 44rem;
    margin: 1.5rem auto 0;
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    background: var(--bg-secondary);
    overflow: hidden;
  }

  .stat {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    padding: 0.875rem 0.5rem;
  }

  .stat + .stat {
    border-left: 1px solid var(--border-color);
  }

  .stat-value {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-primary-600, #4f46e5);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  :global(.dark) .stat-value {
    color: var(--color-primary-400, #818cf8);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
    max-width: 56rem;
    margin-left: auto;
    margin-right: auto;
  }

  .feature-card {
    display: block;
    padding: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .feature-card:hover {
    border-color: var(--border-active);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.5rem;
    background: var(--color-primary-50, #eef2ff);
    color: var(--color-primary-600, #4f46e5);
    margin-bottom: 0.75rem;
  }

  :global(.dark) .feature-icon {
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-primary-400, #818cf8);
  }

  .feature-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .feature-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.625;
  }

  .why-section {
    max-width: 56rem;
    margin: 4rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid var(--border-color);
  }

  .why-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .why-card {
    padding: 1.25rem;
    text-align: center;
  }

  .why-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary-600, #4f46e5);
    margin-bottom: 0.75rem;
  }

  :global(.dark) .why-icon {
    color: var(--color-primary-400, #818cf8);
  }

  .why-card h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .why-card p {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    text-align: left;
  }

  .roadmap-section {
    max-width: 42rem;
    margin: 4rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid var(--border-color);
  }

  .section-heading {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    text-align: center;
    margin-bottom: 0.5rem;
  }

  .section-subheading {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    text-align: center;
    margin-bottom: 2rem;
  }

  .roadmap {
    position: relative;
    max-width: 32rem;
    margin: 0 auto;
    padding-left: 2rem;
  }

  .roadmap-line {
    position: absolute;
    left: calc(2rem + 1.25rem - 1px);
    top: 1.25rem;
    bottom: 1.25rem;
    width: 2px;
    background: linear-gradient(to bottom, var(--color-primary-300, #a5b4fc), var(--color-primary-500, #6366f1));
  }

  :global(.dark) .roadmap-line {
    background: linear-gradient(to bottom, var(--color-primary-700, #4338ca), var(--color-primary-500, #6366f1));
  }

  .roadmap-step {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding-bottom: 2rem;
  }

  .roadmap-step:last-child {
    padding-bottom: 0;
  }

  .step-circle {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-primary-600, #4f46e5);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    flex-shrink: 0;
    z-index: 1;
    position: relative;
  }

  .step-content {
    padding-top: 0.375rem;
    min-width: 0;
  }

  .step-content h4 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .step-content p {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.375rem;
  }

  .rm-link {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-primary-600, #4f46e5);
    text-decoration: none;
  }

  .rm-link:hover {
    text-decoration: underline;
  }

  :global(.dark) .rm-link {
    color: var(--color-primary-400, #818cf8);
  }

  .quickref-section {
    max-width: 42rem;
    margin: 3rem auto 0;
    padding-top: 3rem;
    border-top: 1px solid var(--border-color);
  }

  .quickref-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .qr-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 1.25rem;
    gap: 1rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .qr-row:not(:last-child) {
    border-bottom: 1px solid var(--border-color);
  }

  .qr-row:hover {
    background: var(--bg-hover);
  }

  .qr-want {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .qr-go {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary-600, #4f46e5);
    white-space: nowrap;
    flex-shrink: 0;
  }

  :global(.dark) .qr-go {
    color: var(--color-primary-400, #818cf8);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 2rem 0 1.5rem;
    }

    .hero-title {
      font-size: 1.75rem;
    }

    .why-section {
      margin-top: 2.5rem;
      padding-top: 2rem;
    }

    .roadmap-section {
      margin-top: 2.5rem;
      padding-top: 2rem;
    }

    .quickref-section {
      margin-top: 2rem;
      padding-top: 2rem;
    }

    .qr-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
      padding: 0.75rem 1rem;
    }

    .stats {
      flex-wrap: wrap;
    }

    .stat {
      flex: 1 1 50%;
      padding: 0.75rem 0.25rem;
    }

    .stat + .stat {
      border-left: none;
    }

    .stat:nth-child(even) {
      border-left: 1px solid var(--border-color);
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--border-color);
    }

    .stat-value {
      font-size: 1.125rem;
    }
  }
</style>
