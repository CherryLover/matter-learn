---
import DocLayout from '../../../layouts/DocLayout.astro';
import { SUPPORTED_LANGS, type Lang } from '../../../i18n/config';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const text = lang === 'en'
  ? (await import('../../../i18n/en/pages/compare')).default
  : (await import('../../../i18n/zh/pages/compare')).default;

// 表格单元格里避免难看的断行：Wi-Fi / Z-Wave 等词不在连字符处折行，数字和单位、数字范围（10–30）不拆开
const nb = (str: string) =>
  str
    .replace(/\b(Wi|Z|sub|LTE|NB)-(Fi|Wave|GHz|M|IoT)\b/g, '$1\u2011$2')
    .replace(/(\d) (m|km|kbps|Mbps|MHz|GHz)\b/g, '$1\u00a0$2')
    .replace(/(\d)–(\d)/g, '$1\u2060–\u2060$2');

// OSI 第 7 层画在最上面：第 n 层对应网格第 (9 - n) 行（第 1 行是表头）
const rowOf = (layer: number) => 9 - layer;
---

<DocLayout
  title={text.title}
  description={text.description}
  type="article"
  lang={lang}
>
  <h1>{text.heading}</h1>
  <p set:html={text.intro} />

  <div class="callout callout-info">
    <div class="callout-title">{text.tldrTitle}</div>
    <ul>
      {text.tldr.map((item: string) => <li set:html={item} />)}
    </ul>
  </div>

  <h2 id="layers">{text.layersHeading}</h2>
  <p set:html={text.layersIntro} />

  <div class="stack-scroll">
    <div class="stack-grid" role="img" aria-label={text.layersHeading}>
      <div class="stack-head stack-osi-head" style="grid-column: 1; grid-row: 1;">{text.osiHeader}</div>
      {text.stackColumns.map((name: string, i: number) => (
        <div class="stack-head" style={`grid-column: ${i + 2}; grid-row: 1;`}>{name}</div>
      ))}
      {text.osiLayers.map((l: { n: number; name: string }) => (
        <div class="stack-osi" style={`grid-column: 1; grid-row: ${rowOf(l.n)};`}>
          <span class="stack-osi-n">L{l.n}</span>
          <span>{l.name}</span>
        </div>
      ))}
      {text.stackCells.map((c: any) => (
        <div
          class={`stack-cell stack-${c.kind}`}
          style={`grid-column: ${c.col + 1} / span ${c.span ?? 1}; grid-row: ${rowOf(c.top)} / span ${c.top - c.bottom + 1};`}
        >
          <span class="stack-label">{c.label}</span>
          {c.sub && <span class="stack-sub">{c.sub}</span>}
        </div>
      ))}
    </div>
  </div>

  <div class="stack-legend">
    {text.legend.map((l: { kind: string; label: string }) => (
      <span class="stack-legend-item"><span class={`stack-swatch stack-${l.kind}`}></span>{l.label}</span>
    ))}
  </div>

  <ul>
    {text.layersNotes.map((n: string) => <li set:html={n} />)}
  </ul>

  <div class="callout callout-warning">
    <div class="callout-title">{text.mistakeTitle}</div>
    <p set:html={text.mistakeBody} />
  </div>

  <h2 id="comparison">{text.tableHeading}</h2>
  <p>{text.tableIntro}</p>
  <div class="table-wrap">
    <table class="cmp-table cmp-params">
      <thead>
        <tr>{text.tableColumns.map((h: string) => <th>{nb(h)}</th>)}</tr>
      </thead>
      <tbody>
        {text.tableRows.map((row: string[]) => (
          <tr>
            {row.map((cell, i) => (i === 0 ? <th scope="row">{nb(cell)}</th> : <td>{nb(cell)}</td>))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="similarities">{text.sameHeading}</h2>
  <div class="point-list">
    {text.same.map((p: { title: string; desc: string }) => (
      <div class="point">
        <div class="point-title">{p.title}</div>
        <p set:html={p.desc} />
      </div>
    ))}
  </div>

  <h2 id="differences">{text.diffHeading}</h2>
  <div class="point-list">
    {text.diffs.map((p: { title: string; desc: string }) => (
      <div class="point point-diff">
        <div class="point-title">{p.title}</div>
        <p set:html={p.desc} />
      </div>
    ))}
  </div>

  <h2 id="model-mapping">{text.mappingHeading}</h2>
  <p>{text.mappingIntro}</p>
  <div class="table-wrap">
    <table class="cmp-table cmp-mapping">
      <thead>
        <tr>{text.mappingColumns.map((h: string) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {text.mappingRows.map((row: string[]) => (
          <tr>
            {row.map((cell, i) => (i === 0 ? <th scope="row">{nb(cell)}</th> : <td>{nb(cell)}</td>))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 id="turn-on-a-light">{text.exampleHeading}</h3>
  <div class="table-wrap">
    <table class="cmp-table cmp-example">
      <thead>
        <tr>{text.exampleColumns.map((h: string) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {text.exampleRows.map((row: string[]) => (
          <tr>{row.map((cell, i) => (i === 0 ? <th scope="row" set:html={nb(cell)} /> : <td set:html={nb(cell)} />))}</tr>
        ))}
      </tbody>
    </table>
  </div>
  <p set:html={text.exampleNote} />

  <h2 id="bridges">{text.bridgeHeading}</h2>
  <Fragment set:html={text.bridgeBody} />

  <h2 id="choosing">{text.chooseHeading}</h2>
  <div class="table-wrap">
    <table class="cmp-table cmp-choose">
      <thead>
        <tr>{text.chooseColumns.map((h: string) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {text.chooseRows.map((row: string[]) => (
          <tr><th scope="row">{nb(row[0])}</th><td>{nb(row[1])}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="others">{text.othersHeading}</h2>
  <p>{text.othersIntro}</p>
  <div class="table-wrap">
    <table class="cmp-table cmp-others">
      <thead>
        <tr>{text.othersColumns.map((h: string) => <th>{h}</th>)}</tr>
      </thead>
      <tbody>
        {text.othersRows.map((row: string[]) => (
          <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{nb(cell)}</th> : <td>{nb(cell)}</td>))}</tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="sources">{text.sourcesHeading}</h2>
  <ul>
    {text.sources.map((s: { name: string; url: string }) => (
      <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.name}</a></li>
    ))}
  </ul>
</DocLayout>

<style>
  .stack-scroll {
    overflow-x: auto;
    margin: 1rem 0 0.75rem;
    -webkit-overflow-scrolling: touch;
  }

  .stack-grid {
    display: grid;
    grid-template-columns: 5.5rem repeat(6, minmax(7.5rem, 1fr));
    grid-template-rows: auto repeat(7, minmax(3.5rem, auto));
    gap: 4px;
    min-width: 820px;
    font-size: 0.75rem;
    line-height: 1.35;
  }

  .stack-head {
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--text-primary);
    text-align: center;
    padding: 0.375rem 0.25rem;
    align-self: end;
  }

  .stack-osi-head {
    color: var(--text-muted);
    font-size: 0.75rem;
  }

  .stack-osi {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--bg-secondary);
    color: var(--text-secondary);
    border: 1px dashed var(--border-color);
  }

  .stack-osi-n {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-primary);
  }

  .stack-cell {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.125rem;
    padding: 0.375rem 0.5rem;
    border-radius: 0.375rem;
    border: 1px solid;
  }

  .stack-label {
    font-weight: 600;
  }

  .stack-sub {
    font-size: 0.6875rem;
    opacity: 0.85;
  }

  /* 按层级功能着色：浅色模式 */
  .stack-app { background: #ede9fe; border-color: #c4b5fd; color: #4c1d95; }
  .stack-sec { background: #fce7f3; border-color: #f9a8d4; color: #831843; }
  .stack-transport { background: #ffedd5; border-color: #fdba74; color: #7c2d12; }
  .stack-net { background: #e0f2fe; border-color: #7dd3fc; color: #0c4a6e; }
  .stack-link { background: #dcfce7; border-color: #86efac; color: #14532d; }
  .stack-phy { background: #f1f5f9; border-color: #cbd5e1; color: #1e293b; }

  /* 深色模式 */
  :global(:root.dark) .stack-app { background: rgba(139, 92, 246, 0.18); border-color: rgba(167, 139, 250, 0.45); color: #ddd6fe; }
  :global(:root.dark) .stack-sec { background: rgba(236, 72, 153, 0.16); border-color: rgba(244, 114, 182, 0.45); color: #fbcfe8; }
  :global(:root.dark) .stack-transport { background: rgba(249, 115, 22, 0.16); border-color: rgba(251, 146, 60, 0.45); color: #fed7aa; }
  :global(:root.dark) .stack-net { background: rgba(14, 165, 233, 0.16); border-color: rgba(56, 189, 248, 0.45); color: #bae6fd; }
  :global(:root.dark) .stack-link { background: rgba(34, 197, 94, 0.15); border-color: rgba(74, 222, 128, 0.45); color: #bbf7d0; }
  :global(:root.dark) .stack-phy { background: rgba(148, 163, 184, 0.14); border-color: rgba(148, 163, 184, 0.4); color: #e2e8f0; }

  .stack-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .stack-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .stack-swatch {
    display: inline-block;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 0.25rem;
    border: 1px solid;
  }

  /* ===== 本页表格统一样式 ===== */
  .cmp-table {
    table-layout: fixed;
    width: 100%;
    line-height: 1.55;
  }

  .cmp-table th,
  .cmp-table td {
    padding: 0.625rem 0.75rem;
    text-align: left;
    vertical-align: top;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .cmp-table thead th {
    white-space: nowrap;
  }

  /* 行标题：加粗 + 浅底色，横向滚动时固定在左侧 */
  .cmp-table tbody th[scope='row'] {
    position: sticky;
    left: 0;
    z-index: 1;
    font-weight: 600;
    color: var(--text-primary);
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    border-right: 1px solid var(--border-color);
  }

  .cmp-table thead th:first-child {
    position: sticky;
    left: 0;
    z-index: 2;
    border-right: 1px solid var(--border-color);
  }

  .cmp-table tbody tr:last-child th[scope='row'] {
    border-bottom: none;
  }

  .cmp-table :global(code) {
    white-space: nowrap;
  }

  /* 各表列宽 */
  .cmp-params { min-width: 880px; }
  .cmp-params th:first-child { width: 9rem; }

  .cmp-mapping { min-width: 720px; }
  .cmp-mapping th:first-child { width: 9.5rem; }

  .cmp-example { min-width: 680px; }
  .cmp-example th:nth-child(1) { width: 7.5rem; }
  .cmp-example th:nth-child(2) { width: 30%; }
  .cmp-example th:nth-child(4) { width: 20%; }

  .cmp-choose { min-width: 560px; }
  .cmp-choose th:first-child { width: 42%; }
  .cmp-choose tbody th[scope='row'] { font-weight: 500; }

  .cmp-others { min-width: 760px; }
  .cmp-others th:nth-child(1) { width: 9.5rem; }
  .cmp-others th:nth-child(2) { width: 22%; }
  .cmp-others th:nth-child(3) { width: 26%; }

  /* 手机上收窄固定的第一列，给内容列留出空间 */
  @media (max-width: 640px) {
    .cmp-params { min-width: 760px; }
    .cmp-params th:first-child,
    .cmp-mapping th:first-child,
    .cmp-others th:nth-child(1) { width: 6.5rem; }
    .cmp-example th:nth-child(1) { width: 5.5rem; }
    .cmp-table th,
    .cmp-table td { padding: 0.5rem 0.625rem; }
  }

  .point-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.75rem;
    margin: 1rem 0;
  }

  .point {
    border: 1px solid var(--border-color);
    border-left: 3px solid #22c55e;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--bg-secondary);
  }

  .point-diff {
    border-left-color: #f59e0b;
  }

  .point-title {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .point p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-secondary);
  }
</style>
