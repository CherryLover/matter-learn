---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ArrowUpRight } from 'lucide-astro';
import { SUPPORTED_LANGS, localePath, type Lang } from '../../../i18n/config';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const lp = (path: string) => localePath(lang, path);

const res = lang === 'en'
  ? (await import('../../../i18n/en/pages/resources')).default
  : (await import('../../../i18n/zh/pages/resources')).default;

const iconMap: Record<string, string> = {
  landmark: '🏛️',
  building: '🏢',
  cpu: '🔧',
  github: '📦',
  flask: '🧪',
  globe: '🌐',
  book: '📚',
  award: '🏅',
};
---

<BaseLayout title={res.title} description={res.description} lang={lang}>
  <!-- Hero -->
  <div class="res-hero">
    <h1 class="res-hero-title">{res.heroTitle}</h1>
    <p class="res-hero-desc">{res.heroDesc}</p>
    <div class="res-hero-stats">
      <span class="res-stat">{res.heroCount}</span>
      <span class="res-stat-sep">·</span>
      <span class="res-stat">{res.heroCategoryCount}</span>
    </div>
  </div>

  <!-- Category navigation chips -->
  <nav class="res-chips" aria-label="Category navigation">
    {res.categories.map((cat: any) => (
      <a href={`#${cat.id}`} class="res-chip">
        <span class="res-chip-icon">{iconMap[cat.icon] || '📁'}</span>
        {cat.title}
      </a>
    ))}
  </nav>

  <!-- Category sections -->
  <div class="res-sections">
    {res.categories.map((cat: any) => (
      <section id={cat.id} class="res-section">
        <div class="res-section-header">
          <span class="res-section-icon">{iconMap[cat.icon] || '📁'}</span>
          <div>
            <h2 class="res-section-title">{cat.title}</h2>
            <p class="res-section-desc">{cat.desc}</p>
          </div>
          <span class="res-section-count">{cat.sites.length}</span>
        </div>

        <div class="res-grid">
          {cat.sites.map((site: any) => (
            <a href={site.url} target="_blank" rel="noopener noreferrer" class="res-card">
              <div class="res-card-head">
                <span class="res-card-name">{site.name}</span>
                <ArrowUpRight class="res-card-arrow" size={14} strokeWidth={2} />
              </div>
              <p class="res-card-desc">{site.desc}</p>
              <span class="res-card-url">{new URL(site.url).hostname}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

<style is:global>
  /* ── Hero ───────────────────────────────────────────── */
  .res-hero {
    text-align: center;
    padding: 2rem 0 1.5rem;
  }

  .res-hero-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
  }

  .res-hero-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 40rem;
    margin: 0 auto 1rem;
    line-height: 1.7;
  }

  .res-hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .res-stat {
    background: var(--bg-secondary);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-weight: 500;
  }

  .res-stat-sep {
    color: var(--text-muted);
    opacity: 0.4;
  }

  /* ── Category chips ────────────────────────────────── */
  .res-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin-bottom: 2.5rem;
    padding: 0 0.5rem;
  }

  .res-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: all 0.15s ease;
    white-space: nowrap;
  }

  .res-chip:hover {
    border-color: var(--color-primary-400, #818cf8);
    color: var(--color-primary-600, #4f46e5);
    background: var(--bg-hover);
  }

  .res-chip-icon {
    font-size: 0.875rem;
  }

  /* ── Sections ──────────────────────────────────────── */
  .res-sections {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-bottom: 2rem;
  }

  .res-section-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-color);
  }

  .res-section-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
    margin-top: 0.125rem;
  }

  .res-section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.4;
  }

  .res-section-desc {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0.25rem 0 0;
    line-height: 1.5;
  }

  .res-section-count {
    margin-left: auto;
    flex-shrink: 0;
    background: var(--color-primary-50, #eef2ff);
    color: var(--color-primary-600, #4f46e5);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: 9999px;
    align-self: center;
  }

  :global(.dark) .res-section-count {
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-primary-400, #818cf8);
  }

  /* ── Card grid ─────────────────────────────────────── */
  .res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 0.875rem;
  }

  .res-card {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border-color);
    border-radius: 0.625rem;
    text-decoration: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
    background: var(--bg-primary);
  }

  .res-card:hover {
    border-color: var(--color-primary-400, #818cf8);
    box-shadow: 0 2px 12px rgba(99, 102, 241, 0.08);
    transform: translateY(-1px);
  }

  .res-card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .res-card-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .res-card-arrow {
    flex-shrink: 0;
    color: var(--text-muted);
    opacity: 0.4;
    transition: opacity 0.15s ease, color 0.15s ease;
    margin-top: 0.125rem;
  }

  .res-card:hover .res-card-arrow {
    opacity: 1;
    color: var(--color-primary-500, #6366f1);
  }

  .res-card-desc {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0 0 0.625rem;
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .res-card-url {
    font-size: 0.6875rem;
    color: var(--text-muted);
    opacity: 0.6;
  }

  /* ── Mobile ────────────────────────────────────────── */
  @media (max-width: 640px) {
    .res-hero-title {
      font-size: 1.5rem;
    }

    .res-hero-desc {
      font-size: 0.9375rem;
    }

    .res-grid {
      grid-template-columns: 1fr;
    }

    .res-section-header {
      flex-wrap: wrap;
    }
  }
</style>
