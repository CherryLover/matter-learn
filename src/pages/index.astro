---
/**
 * Root path (/) — redirect to language-prefixed path
 * Uses client-side detection: localStorage preference > navigator.language > default zh
 */
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <title>Matter Learn</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${Astro.site}zh/`} />
    <script is:inline>
      (function() {
        try {
          var saved = localStorage.getItem('preferredLang');
          if (saved === 'en') { window.location.replace('/en/'); return; }
          if (saved === 'zh') { window.location.replace('/zh/'); return; }
        } catch(e) {}
        // Detect browser language preference
        var langs = (navigator.languages || [navigator.language || '']);
        var prefersEn = false;
        for (var i = 0; i < langs.length; i++) {
          var l = (langs[i] || '').toLowerCase();
          if (l.indexOf('zh') === 0) break;    // Chinese found first
          if (l.indexOf('en') === 0) { prefersEn = true; break; }
        }
        window.location.replace(prefersEn ? '/en/' : '/zh/');
      })();
    </script>
    <!-- Fallback for no-JS: default to Chinese -->
    <noscript>
      <meta http-equiv="refresh" content="0;url=/zh/" />
    </noscript>
  </head>
  <body>
    <p>Redirecting...</p>
  </body>
</html>
