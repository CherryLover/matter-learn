    "Ranges": [
      {
        "MeasurementType": 1,        // Voltage
        "Min": 218500,               // 最低 218.5 V
        "Max": 222100,               // 最高 222.1 V
        "StartTimestamp": 1695600000,
        "EndTimestamp": 1695603600
      },
      {
        "MeasurementType": 5,        // ActivePower
        "Min": 280000,               // 最低 280.0 W
        "Max": 350000,               // 最高 350.0 W
        "StartTimestamp": 1695600000,
        "EndTimestamp": 1695603600
      }
    ]
  }
}`;
