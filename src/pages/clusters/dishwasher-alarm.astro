  // --- 告警位图属性 ---
  "0x0000": "0x0000003F",    // Mask = 0x3F（全部 6 种告警均已启用）
  "0x0001": "0x00000003",    // Latch = 0x03（InflowError + DrainError 需手动复位）
  "0x0002": "0x00000002",    // State = 0x02（当前 DrainError 告警激活）
