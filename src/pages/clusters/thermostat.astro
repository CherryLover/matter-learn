        <tr id="attr-0x47">
          <td><code>0x47</code></td>
          <td>ACCapacityFormat<br/><span class="attr-cn">容量格式</span></td>
          <td>enum8</td>
          <td>ACCapacity 的单位格式。<code>0</code> = BTU/h</td>
        </tr>
      </tbody>
    </table>
