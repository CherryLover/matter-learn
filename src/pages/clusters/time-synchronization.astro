          <td><a href="#cmd-0x04"><code>0x04</code></a></td>
          <td>SetDSTOffset</td>
          <td>设置夏令时偏移列表</td>
          <td class="col-required">TZ</td>
        </tr>
        <tr class="clickable-row" data-href="#cmd-0x07">
          <td><a href="#cmd-0x07"><code>0x07</code></a></td>
          <td>SetDefaultNTP</td>
          <td>设置默认 NTP 服务器地址</td>
          <td class="col-required">NTPC</td>
        </tr>
      </tbody>
    </table>
