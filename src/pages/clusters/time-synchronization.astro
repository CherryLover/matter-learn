          <th>说明</th>
        </tr>
      </thead>
      <tbody>
        <!-- 时间状态 -->
        <tr class="clickable-row" data-href="#attr-0x0000">
          <td><a href="#attr-0x0000"><code>0x0000</code></a></td>
          <td>UTCTime</td>
          <td>epoch_us / null</td>
