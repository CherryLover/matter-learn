        </tr>
        <tr id="attr-0x87">
          <td><code>0x87</code></td>
          <td>NumberOfAliroCredentialIssuerKeysSupported<br/><span class="attr-cn">凭据发行密钥数</span></td>
          <td>uint16</td>
          <td>设备支持的 Aliro 凭据发行者密钥数量</td>
