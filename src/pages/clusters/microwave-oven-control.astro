        <tr class="clickable-row" data-href="#attr-0x0007">
          <td><a href="#attr-0x0007"><code>0x0007</code></a></td>
          <td>SupportedWatts</td>
          <td>list[uint16]</td>
          <td><a href="#group-watts">瓦数等级</a></td>
          <td>设备支持的瓦数列表</td>
