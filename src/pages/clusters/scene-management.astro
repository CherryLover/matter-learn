  // --- Fabric 场景信息 ---
  "0x0002": [              // FabricSceneInfo（当前 Fabric 的场景概况）
    {
      "SceneCount": 3,           // 当前 Fabric 已存储 3 个场景
      "CurrentScene": 1,         // 当前激活的场景 ID
