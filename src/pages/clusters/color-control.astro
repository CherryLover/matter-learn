  <h4>EnhancedColorMode 枚举值</h4>
  <div class="enum-cards enum-cards-grid">
    <div class="enum-card">
      <span class="enum-badge">0</span>
      <div>
        <span class="enum-name">CurrentHueAndCurrentSaturation</span>
